rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // `{file}` is `{id}.jpg` for the public card `sightings_public/{id}`.
    function publicSightingFile(file) {
      return file.matches('^.+\\.jpg$')
        && firestore.exists(/databases/(default)/documents/sightings_public/$(file.split('\\.jpg')[0]));
    }

    // The owner document `sightings/{id}` names this account.
    function ownsSightingFile(file) {
      return file.matches('^.+\\.jpg$')
        && firestore.exists(/databases/(default)/documents/sightings/$(file.split('\\.jpg')[0]))
        && firestore.get(/databases/(default)/documents/sightings/$(file.split('\\.jpg')[0])).data.uid == request.auth.uid;
    }

    // Guest-readable copy. The object name is the sighting id, not an account.
    match /sightings/public/{file} {
      allow read: if publicSightingFile(file);
      allow delete: if signedIn() && ownsSightingFile(file);
      allow create, update: if false;
    }

    match /sightings/{uid}/{file} {
      // The owner's JPEG. A guest reads sightings/public/{id}.jpg instead.
      // Another device calls getDownloadURL while signed in and keeps that
      // URL on the phone. It is not stored on the document.
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if owns(uid);
    }
  }
}
