rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalog reads for the field guide. No client writes.
    match /species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /translations/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /headers/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /labels/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /synonyms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /search/{lang}/names/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /taxonomy/{lang}/taxa/{id} {
      allow read: if true;
      allow write: if false;
    }
    // meta/versions: minAndroid and minIos are the lowest builds still
    // allowed. android and ios are the builds currently on the stores.
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /curated_lists/{listId} {
      allow read: if true;
      allow write: if false;
    }

    // Checked Field Guide plans. Cloud Functions write them after Apple or
    // Google confirms the receipt. The owner can read them. A purchase on
    // either store unlocks the other phone from this document.
    // `lifetime subscription: true` is Field Guide. An admin write sets it.
    // The phone only reads it.
    // The signed-in owner may also store or clear the push token. No other
    // field is writable from the client.
    match /users/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 4096;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token'])
        && (
          !request.resource.data.keys().hasAll(['token'])
          || (
            request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() < 4096
          )
        );
      allow delete: if false;
    }
    match /purchase_proofs/{id} {
      allow read, write: if false;
    }
    match /store_accounts/{id} {
      allow read, write: if false;
    }

    // Photo names for the month. Cloud Functions write the meter. The
    // signed-in owner can read it so a rewarded ad can update the phone
    // after AdMob's callback. Clients cannot grant a name.
    match /photo_quota/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if false;
    }

    // AdMob server-side verification receipts. A replay of transaction_id
    // finds the document and does not grant again.
    match /admob_rewards/{id} {
      allow read, write: if false;
    }

    // Leading Plant.id names that are not in the book, one document per
    // UTC month and Latin key. identifyMushroom writes { name, count }.
    // Clients cannot read or write the tally.
    match /photo_name_tally/{month} {
      allow read, write: if false;
      match /names/{key} {
        allow read, write: if false;
      }
    }

    // A Sighting sent from Seen. The owner creates it as review and may
    // delete it. Publishing or rejecting is an admin write.
    match /sightings/{id} {
      allow read: if resource.data.status == 'public' ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'review'
        && request.resource.data.latin is string
        && request.resource.data.latin.size() > 0
        && request.resource.data.latin.size() < 200
        && request.resource.data.millis is int
        && request.resource.data.photo == 'sightings/' + request.auth.uid + '/' + id + '.jpg'
        && request.resource.data.keys().hasOnly(['uid', 'latin', 'millis', 'status', 'photo']);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
