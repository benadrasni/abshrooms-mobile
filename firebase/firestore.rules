rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalog reads for the field guide. No client writes.
    match /species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /translations/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /headers/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /labels/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /synonyms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /search/{lang}/names/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /taxonomy/{lang}/taxa/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /curated_lists/{listId} {
      allow read: if true;
      allow write: if false;
    }

    // A Sighting sent from Seen. The owner creates it as review and may
    // delete it. Publishing or rejecting is an admin write.
    match /sightings/{id} {
      allow read: if resource.data.status == 'public' ||
        (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'review'
        && request.resource.data.latin is string
        && request.resource.data.latin.size() > 0
        && request.resource.data.latin.size() < 200
        && request.resource.data.millis is int
        && request.resource.data.photo == 'sightings/' + request.auth.uid + '/' + id + '.jpg'
        && request.resource.data.keys().hasOnly(['uid', 'latin', 'millis', 'status', 'photo']);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
