rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalog reads for the field guide. No client writes.
    match /species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /translations/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /headers/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /labels/{lang}/species/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /synonyms/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /search/{lang}/names/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /taxonomy/{lang}/taxa/{id} {
      allow read: if true;
      allow write: if false;
    }
    // meta/versions: minAndroid and minIos are the lowest builds still
    // allowed. android and ios are the builds currently on the stores.
    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /curated_lists/{listId} {
      allow read: if true;
      allow write: if false;
    }

    // Checked Field Guide plans. Cloud Functions write them after Apple or
    // Google confirms the receipt. The owner can read them. A purchase on
    // either store unlocks the other phone from this document.
    // `lifetime subscription: true` is Field Guide. An admin write sets it.
    // The phone only reads it.
    // The signed-in owner may also store or clear the push token. No other
    // field is writable from the client.
    match /users/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 0
        && request.resource.data.token.size() < 4096;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['token'])
        && (
          !request.resource.data.keys().hasAll(['token'])
          || (
            request.resource.data.token is string
            && request.resource.data.token.size() > 0
            && request.resource.data.token.size() < 4096
          )
        );
      allow delete: if false;
    }

    // Favorite mushrooms for the signed-in account. One document per Latin
    // name, and the only field is v = 1, as on the plants account. A guest
    // cannot read or write them. Deleting the account removes the documents.
    match /users/{uid}/favorites/{latin} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && latin.size() > 0
        && latin.size() < 200
        && request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.v == 1;
      allow delete: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /purchase_proofs/{id} {
      allow read, write: if false;
    }
    match /store_accounts/{id} {
      allow read, write: if false;
    }

    // Photo names for the month. Cloud Functions write the meter. The
    // signed-in owner can read it so a rewarded ad can update the phone
    // after AdMob's callback. Clients cannot grant a name.
    match /photo_quota/{uid} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if false;
    }

    // AdMob server-side verification receipts. A replay of transaction_id
    // finds the document and does not grant again.
    match /admob_rewards/{id} {
      allow read, write: if false;
    }

    // Leading Plant.id names that are not in the book, one document per
    // UTC month and Latin key. identifyMushroom writes { name, count }.
    // Clients cannot read or write the tally.
    match /photo_name_tally/{month} {
      allow read, write: if false;
      match /names/{key} {
        allow read, write: if false;
      }
    }

    // A lowercase ISO country. Absent is allowed.
    function sightingCountryOk(data) {
      return !data.keys().hasAny(['country'])
        || (data.country is string && data.country.matches('^[a-z]{2}$'));
    }

    // Coordinates of the find, both or neither. 0, 0 is not a place.
    function sightingPlaceOk(data) {
      let hasLat = data.keys().hasAny(['latitude']);
      let hasLng = data.keys().hasAny(['longitude']);
      return hasLat == hasLng
        && (!hasLat || (
          data.latitude is number
          && data.longitude is number
          && data.latitude >= -90
          && data.latitude <= 90
          && data.longitude >= -180
          && data.longitude <= 180
          && !(data.latitude == 0 && data.longitude == 0)
        ));
    }

    // Optional short text. Absent is allowed. Latin may be absent: a find
    // outside the book stores outsideName instead.
    function privateNameOk(data, key) {
      return !data.keys().hasAny([key])
        || (
          data[key] is string
          && data[key].size() > 0
          && data[key].size() < 200
        );
    }

    function privateProbabilityOk(data) {
      return !data.keys().hasAny(['probability'])
        || (
          data.probability is number
          && data.probability >= 0
          && data.probability <= 1
        );
    }

    function privateShareOk(data) {
      return !data.keys().hasAny(['share'])
        || data.share == 'review'
        || data.share == 'shared'
        || data.share == 'rejected';
    }

    function privatePhotoOk(data, id) {
      return !data.keys().hasAny(['photo'])
        || data.photo == 'private/' + request.auth.uid + '/' + id + '.jpg';
    }

    function privateOthersOk(data) {
      return !data.keys().hasAny(['others'])
        || (data.others is list && data.others.size() < 12);
    }

    // A private find. The client writes one only while Field Guide is
    // active. The plan sits in a nested entitlements map, so the rule
    // checks the owner, not the plan.
    function privateFindOk(id) {
      let data = request.resource.data;
      return id.matches('^[A-Za-z0-9_-]{1,80}$')
        && data.keys().hasAll(['millis', 'updated', 'confirmed'])
        && data.keys().hasOnly(['millis', 'updated', 'confirmed', 'latin', 'outsideName', 'spoken', 'probability', 'latitude', 'longitude', 'country', 'share', 'photo', 'others'])
        && data.millis is int
        && data.millis > 0
        && data.updated is int
        && data.updated > 0
        && data.confirmed is bool
        && privateNameOk(data, 'latin')
        && privateNameOk(data, 'outsideName')
        && privateNameOk(data, 'spoken')
        && privateProbabilityOk(data)
        && sightingCountryOk(data)
        && sightingPlaceOk(data)
        && privateShareOk(data)
        && privatePhotoOk(data, id)
        && privateOthersOk(data);
    }

    // Private notebook for the signed-in account. A guest cannot read it.
    // Deleting the account removes the documents. This is not a Sighting:
    // nothing here is public, and status review is not used.
    match /users/{uid}/finds/{id} {
      allow read: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && privateFindOk(id);
      allow delete: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // A Sighting sent from Seen. The owner creates it as review and may
    // delete it. Publishing or rejecting is an admin write. The document
    // keeps the account, the country, and the coordinates. Guests cannot
    // read it. The public card is sightings_public.
    match /sightings/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'review'
        && request.resource.data.latin is string
        && request.resource.data.latin.size() > 0
        && request.resource.data.latin.size() < 200
        && request.resource.data.millis is int
        && request.resource.data.photo == 'sightings/' + request.auth.uid + '/' + id + '.jpg'
        && request.resource.data.keys().hasAll(['uid', 'latin', 'millis', 'status', 'photo'])
        && request.resource.data.keys().hasOnly(['uid', 'latin', 'millis', 'status', 'photo', 'country', 'latitude', 'longitude'])
        && sightingCountryOk(request.resource.data)
        && sightingPlaceOk(request.resource.data);
      // The owner may add the country and the coordinates after the share.
      // Status stays an admin write.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['country', 'latitude', 'longitude'])
        && request.resource.data.diff(resource.data).affectedKeys().size() > 0
        && sightingCountryOk(request.resource.data)
        && sightingPlaceOk(request.resource.data);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // The species page and the website read this card. It has the Latin
    // name, the time, the country, and a photo path with no account in it.
    // The owner may set the country. Nothing else is a client write.
    match /sightings_public/{id} {
      allow read: if true;
      allow create: if false;
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/sightings/$(id))
        && get(/databases/$(database)/documents/sightings/$(id)).data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['country'])
        && sightingCountryOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['latin', 'millis', 'photo', 'country'])
        && !request.resource.data.keys().hasAny(['uid', 'latitude', 'longitude', 'status'])
        && request.resource.data.photo == 'sightings/public/' + id + '.jpg';
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/sightings/$(id))
        && get(/databases/$(database)/documents/sightings/$(id)).data.uid == request.auth.uid;
    }

    // Distinct accounts with a public Sighting. Admin writes the number.
    // The stats page reads it. The public cards do not carry an account.
    match /sightings_stats/{id} {
      allow read: if true;
      allow write: if false;
    }
  }
}
